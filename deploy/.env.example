# Copy to deploy/.env and fill in. deploy/.env is gitignored — keep it that way.

# From @BotFather. This single value verifies every player's identity: treat it
# as a credential, never commit it, and never reuse someone else's.
BOT_TOKEN=123456789:replace-with-your-own-token

# Public HTTPS address where the Mini App is served. Telegram requires HTTPS.
APP_URL=https://your-domain.example
